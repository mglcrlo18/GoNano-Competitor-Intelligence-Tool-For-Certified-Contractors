# Competitor Intelligence Platform - Environment Template
# Copy this file to .env and populate with your own keys:
# cp .env.example .env

# Meta Ad Library Graph API
META_GRAPH_API_TOKEN=your_meta_graph_api_token_here

# Headless SMTP Email Configuration
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
RECIPIENT_EMAIL=your_email@gmail.com
CC_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
